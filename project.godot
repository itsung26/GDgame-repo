[layer_names]

3d_physics/layer_1="player"
3d_physics/layer_2="enemies"
3d_physics/layer_3="world"
3d_physics/layer_4="projectile"
3d_physics/layer_5="pickup"
3d_physics/layer_6="explosions"
3d_physics/layer_9="grapple_boxes"
3d_physics/layer_10="grapple_hook"
