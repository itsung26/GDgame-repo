[layer_names]

3d_render/layer_2="blood decals"
3d_physics/layer_1="player"
3d_physics/layer_2="enemies"
3d_physics/layer_3="world"
3d_physics/layer_4="enemy projectile"
3d_physics/layer_5="force areas"
3d_physics/layer_7="pistol bomb"
3d_physics/layer_8="physical particles"
3d_physics/layer_9="ragdoll"
3d_physics/layer_10="grapple_hook"

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/speculative_contact_distance=0.16
jolt_physics_3d/collisions/collision_margin_fraction=0.16
jolt_physics_3d/simulation/areas_detect_static_bodies=true

[rendering]

textures/canvas_textures/default_texture_filter=3
textures/decals/filter=2
