; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="project"
config/version="PRE-PRE-ALPHA"
config/tags=PackedStringArray("alpha", "main")
run/main_scene="uid://ctkkc4v7jqox5"
config/use_custom_user_dir=true
config/custom_user_dir_name="developer/project"
config/features=PackedStringArray("4.5", "Forward Plus")
run/max_fps=60
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout=""

[autoload]

DebugInputHandler="*res://scripts/debug_input_handler.gd"
EnemyPopulationHandler="*res://scripts/enemy_population_handler.gd"
LoadHandler="*res://scripts/LoadHandler.gd"
Debug="*res://scripts/Debug.gd"
CfgParser="*res://scripts/cfg_parser.gd"
HitscanSystem="*res://scripts/hitscan_system.gd"
RagdollManager="*res://scripts/ragdoll_manager.gd"
RespawnSystem="*res://scripts/respawn_system.gd"
TimeFlowSystem="*res://scripts/time_flow_system.gd"
DecalPool="*res://scripts/decal_pool.gd"
CommandRegistry="*res://scripts/command_registry.gd"
QuickRef="*res://scripts/quick_ref.gd"

[debug]

file_logging/enable_file_logging=true

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

window/size/resizable=false
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/any_icon.editor/plugin.cfg", "res://addons/bbcode_edit.editor/plugin.cfg", "res://addons/deep_raycast_3d/plugin.cfg", "res://addons/func_godot/plugin.cfg")

[global_group]

enemy="contains all enemies"
weapons="Contains all weapons"
players=""
weaponBlocks=""
grapple_cubes=""
"enemy projectiles"=""
"bullet trails"=""
arms=""
explosions=""
"enviroment rigidbodies"=""
"parry visuals"=""
"weak enemy"=""
"ragdoll simulator"=""
"death camera"="The group the death camera belongs to. It should only have 1 member."
"developer console"=""
"free camera"=""
"pistol bombs"=""

