; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="project"
config/version="PRE-ALPHA"
config/tags=PackedStringArray("alpha", "main")
run/main_scene="uid://ctkkc4v7jqox5"
config/features=PackedStringArray("4.4", "Forward Plus")
run/max_fps=60
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout=""

[autoload]

Global="*res://scripts/Global.gd"
Helper="*res://scripts/Helper.gd"
DebugInputHandler="*res://scripts/debug_input_handler.gd"
EnemyPopulationHandler="*res://scripts/enemy_population_handler.gd"
LoadHandler="*res://scripts/LoadHandler.gd"
Stopwatch="*res://scripts/stopwatch.gd"
Debug="*res://scripts/Debug.gd"

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

window/size/resizable=false
window/vsync/vsync_mode=0

[global_group]

enemy="contains all enemies"
weapons="Contains all weapons"
players=""
weaponBlocks=""
"weak enemy"=""
grapple_cubes=""
"enemy projectiles"=""
"bullet trails"=""
arms=""
explosions=""
"enviroment rigidbodies"=""
"parry visuals"=""

