code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform float speed;
uniform float angle;
uniform sampler2D tex_frg_2;
uniform vec4 color : source_color;
uniform float emission;



void fragment() {
// Input:11
	float n_out11p0 = TIME;


// FloatParameter:13
	float n_out13p0 = speed;


// FloatOp:12
	float n_out12p0 = n_out11p0 * n_out13p0;


// VectorCompose:10
	float n_in10p0 = 0.00000;
	vec2 n_out10p0 = vec2(n_in10p0, n_out12p0);


// UVFunc:3
	vec2 n_in3p1 = vec2(1.00000, 1.00000);
	vec2 n_out3p0 = n_out10p0 * n_in3p1 + UV;


// FloatParameter:5
	float n_out5p0 = angle;


	vec3 n_out4p0;
	mat4 n_out4p1;
// RotationByAxis:4
	vec3 n_in4p2 = vec3(0.50000, 0.50000, 0.00000);
	{
		float __angle = n_out5p0;
		vec3 __axis = normalize(n_in4p2);
		mat3 __rot_matrix = mat3(
			vec3( cos(__angle)+__axis.x*__axis.x*(1.0 - cos(__angle)), __axis.x*__axis.y*(1.0-cos(__angle))-__axis.z*sin(__angle), __axis.x*__axis.z*(1.0-cos(__angle))+__axis.y*sin(__angle) ),
			vec3( __axis.y*__axis.x*(1.0-cos(__angle))+__axis.z*sin(__angle), cos(__angle)+__axis.y*__axis.y*(1.0-cos(__angle)), __axis.y*__axis.z*(1.0-cos(__angle))-__axis.x*sin(__angle) ),
			vec3( __axis.z*__axis.x*(1.0-cos(__angle))-__axis.y*sin(__angle), __axis.z*__axis.y*(1.0-cos(__angle))+__axis.x*sin(__angle), cos(__angle)+__axis.z*__axis.z*(1.0-cos(__angle)) )
		);
		n_out4p0 = vec3(n_out3p0, 0.0) * __rot_matrix;
	}


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, vec2(n_out4p0.xy));


// ColorParameter:7
	vec4 n_out7p0 = color;


// VectorOp:6
	vec3 n_out6p0 = vec3(n_out2p0.xyz) * vec3(n_out7p0.xyz);


// FloatParameter:9
	float n_out9p0 = emission;


// VectorOp:8
	vec3 n_out8p0 = vec3(n_out7p0.xyz) * vec3(n_out9p0);


// Output:0
	ALBEDO = n_out6p0;
	ALPHA = n_out2p0.x;
	EMISSION = n_out8p0;


}
"
