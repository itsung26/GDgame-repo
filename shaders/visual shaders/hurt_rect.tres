code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec4 ColorParameter : source_color;
uniform vec2 Vector2Parameter = vec2(1.000000, 1.000000);
uniform sampler2D Texture2DParameter;
uniform sampler2D tex_frg_2;
uniform float Alpha : hint_range(0.0, 1.0) = 1.0;



void fragment() {
// ColorParameter:10
	vec4 n_out10p0 = ColorParameter;


// VectorOp:12
	vec3 n_in12p1 = vec3(1.00000, 1.00000, 1.00000);
	vec3 n_out12p0 = vec3(n_out10p0.xyz) * n_in12p1;


// Vector2Parameter:7
	vec2 n_out7p0 = Vector2Parameter;


// UVFunc:8
	vec2 n_in8p2 = vec2(0.50000, 0.50000);
	vec2 n_out8p0 = (UV - n_in8p2) * n_out7p0 + n_in8p2;


	vec4 n_out6p0;
// Texture2D:6
	n_out6p0 = texture(Texture2DParameter, n_out8p0);


// FloatOp:9
	float n_in9p0 = 1.00000;
	float n_out9p0 = n_in9p0 - n_out6p0.x;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, UV);


// VectorOp:11
	vec3 n_out11p0 = vec3(n_out9p0) - vec3(n_out2p0.xyz);


// FloatParameter:14
	float n_out14p0 = Alpha;


// FloatOp:13
	float n_out13p0 = n_out11p0.x * n_out14p0;


// Output:0
	COLOR.rgb = n_out12p0;
	COLOR.a = n_out13p0;


}
