[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform float radius = 0.30000001192093;
uniform float softness = 0.10000000149012;
uniform vec4 ColorParameter : source_color;
uniform float scissor;



void fragment() {
// FloatParameter:19
	float n_out19p0 = radius;


// FloatParameter:25
	float n_out25p0 = softness;


// FloatOp:24
	float n_out24p0 = n_out19p0 + n_out25p0;


// Input:21
	vec2 n_out21p0 = UV;


// VectorCompose:18
	float n_in18p0 = 0.50000;
	float n_in18p1 = 0.50000;
	vec2 n_out18p0 = vec2(n_in18p0, n_in18p1);


// Distance:13
	float n_out13p0 = distance(n_out21p0, n_out18p0);


// SmoothStep:22
	vec3 n_out22p0 = smoothstep(vec3(n_out24p0), vec3(n_out19p0), vec3(n_out13p0));


// ColorParameter:29
	vec4 n_out29p0 = ColorParameter;


// VectorOp:28
	vec3 n_out28p0 = n_out22p0 * vec3(n_out29p0.xyz);


// FloatParameter:27
	float n_out27p0 = scissor;


// Output:0
	ALBEDO = n_out28p0;
	ALPHA = n_out22p0.x;
	EMISSION = n_out28p0;
	ALPHA_SCISSOR_THRESHOLD = n_out27p0;


}
"
