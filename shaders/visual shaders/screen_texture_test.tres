code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform vec2 red_displacement = vec2(0.000000, 0.000000);
uniform sampler2D Texture2DParameter;
uniform vec2 green_displacement = vec2(0.000000, 0.000000);
uniform vec2 blue_displacement = vec2(0.000000, 0.000000);



void fragment() {
// Vector2Parameter:9
	vec2 n_out9p0 = red_displacement;


// UVFunc:8
	vec2 n_in8p1 = vec2(1.00000, 1.00000);
	vec2 n_out8p0 = n_out9p0 * n_in8p1 + UV;


	vec4 n_out5p0;
// Texture2D:5
	n_out5p0 = texture(Texture2DParameter, n_out8p0);
	float n_out5p1 = n_out5p0.r;


// Vector2Parameter:12
	vec2 n_out12p0 = green_displacement;


// UVFunc:11
	vec2 n_in11p1 = vec2(1.00000, 1.00000);
	vec2 n_out11p0 = n_out12p0 * n_in11p1 + UV;


	vec4 n_out10p0;
// Texture2D:10
	n_out10p0 = texture(Texture2DParameter, n_out11p0);
	float n_out10p2 = n_out10p0.g;


// Vector2Parameter:15
	vec2 n_out15p0 = blue_displacement;


// UVFunc:14
	vec2 n_in14p1 = vec2(1.00000, 1.00000);
	vec2 n_out14p0 = n_out15p0 * n_in14p1 + UV;


	vec4 n_out13p0;
// Texture2D:13
	n_out13p0 = texture(Texture2DParameter, n_out14p0);
	float n_out13p3 = n_out13p0.b;


// VectorCompose:7
	vec3 n_out7p0 = vec3(n_out5p1, n_out10p2, n_out13p3);


// Output:0
	ALBEDO = n_out7p0;


}
