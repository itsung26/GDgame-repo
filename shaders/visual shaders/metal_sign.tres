[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_disabled, diffuse_lambert, specular_schlick_ggx;

uniform vec4 ArrowColor : source_color;
uniform sampler2D tex_frg_5;
uniform sampler2D tex_frg_9;
uniform vec4 border_color : source_color;
uniform sampler2D tex_frg_10;
uniform vec4 main_color : source_color;
uniform float metallic;
uniform float roughness;
uniform bool emission_enabled;
uniform float arrowemissionIntensaity;



void fragment() {
// ColorParameter:6
	vec4 n_out6p0 = ArrowColor;


// Texture2D:5
	vec4 n_out5p0 = texture(tex_frg_5, UV);


// VectorOp:7
	vec3 n_out7p0 = vec3(n_out6p0.xyz) * vec3(n_out5p0.xyz);


// Texture2D:9
	vec4 n_out9p0 = texture(tex_frg_9, UV);


// ColorParameter:14
	vec4 n_out14p0 = border_color;


// VectorOp:13
	vec3 n_out13p0 = vec3(n_out9p0.xyz) * vec3(n_out14p0.xyz);


// VectorOp:8
	vec3 n_out8p0 = n_out7p0 + n_out13p0;


// Texture2D:10
	vec4 n_out10p0 = texture(tex_frg_10, UV);


// ColorParameter:18
	vec4 n_out18p0 = main_color;


// VectorOp:17
	vec3 n_out17p0 = vec3(n_out10p0.xyz) * vec3(n_out18p0.xyz);


// VectorOp:16
	vec3 n_out16p0 = n_out8p0 + n_out17p0;


// FloatParameter:3
	float n_out3p0 = metallic;


// FloatParameter:4
	float n_out4p0 = roughness;


// BooleanParameter:21
	bool n_out21p0 = emission_enabled;


// FloatParameter:20
	float n_out20p0 = arrowemissionIntensaity;


// VectorOp:19
	vec3 n_out19p0 = n_out7p0 * vec3(n_out20p0);


	vec3 n_out22p0;
// If:22
	float n_in22p1 = 0.00000;
	float n_in22p2 = 0.00001;
	vec3 n_in22p3 = vec3(0.00000, 0.00000, 0.00000);
	vec3 n_in22p5 = vec3(0.00000, 0.00000, 0.00000);
	if(abs((n_out21p0 ? 1.0 : 0.0) - n_in22p1) < n_in22p2)
	{
		n_out22p0 = n_in22p3;
	}
	else if((n_out21p0 ? 1.0 : 0.0) < n_in22p1)
	{
		n_out22p0 = n_in22p5;
	}
	else
	{
		n_out22p0 = n_out19p0;
	}


// Output:0
	ALBEDO = n_out16p0;
	METALLIC = n_out3p0;
	ROUGHNESS = n_out4p0;
	EMISSION = n_out22p0;


}
"
