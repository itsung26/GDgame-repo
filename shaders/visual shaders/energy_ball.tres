code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform vec4 ColorParameter : source_color;
uniform vec2 displacement;
uniform vec2 scale;
uniform sampler2D Texture2DParameter : filter_linear_mipmap, repeat_disable;
uniform float emission : hint_range(0.0, 16.0);



void fragment() {
// ColorParameter:4
	vec4 n_out4p0 = ColorParameter;


// Vector2Parameter:11
	vec2 n_out11p0 = displacement;


// UVFunc:10
	vec2 n_in10p1 = vec2(1.00000, 1.00000);
	vec2 n_out10p0 = n_out11p0 * n_in10p1 + UV;


// Vector2Parameter:9
	vec2 n_out9p0 = scale;


// UVFunc:8
	vec2 n_in8p2 = vec2(0.00000, 0.00000);
	vec2 n_out8p0 = (n_out10p0 - n_in8p2) * n_out9p0 + n_in8p2;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Texture2DParameter, n_out8p0);


// VectorOp:5
	vec3 n_out5p0 = vec3(n_out4p0.xyz) * vec3(n_out3p0.xyz);


// FloatParameter:7
	float n_out7p0 = emission;


// VectorOp:6
	vec3 n_out6p0 = n_out5p0 * vec3(n_out7p0);


// Output:0
	ALBEDO = n_out5p0;
	ALPHA = n_out3p0.x;
	EMISSION = n_out6p0;


}
"
