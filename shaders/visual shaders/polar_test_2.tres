[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec4 ColorParameter : source_color;
uniform float radius_param;
uniform float theta_param;


// GlobalExpression:0
	void vertex() {
		MODELVIEW_MATRIX = VIEW_MATRIX * mat4(
				MAIN_CAM_INV_VIEW_MATRIX[0],
				MAIN_CAM_INV_VIEW_MATRIX[1],
				MAIN_CAM_INV_VIEW_MATRIX[2],
				MODEL_MATRIX[3]);
		MODELVIEW_NORMAL_MATRIX = mat3(MODELVIEW_MATRIX);
	}
// GlobalExpression:1
	void vec2 toRectCoords(r, theta) {
		float x = r * cos(theta);
		float y = r * sin(theta);
		return vec2(x, y);
	};

void fragment() {
// ColorParameter:6
	vec4 n_out6p0 = ColorParameter;


	vec2 n_out2p0;
// UVPolarCoord:2
	vec2 n_in2p1 = vec2(0.50000, 0.50000);
	float n_in2p2 = 1.00000;
	float n_in2p3 = 1.00000;
	{
		vec2 __dir = UV - n_in2p1;
		float __radius = length(__dir) * 2.0;
		float __angle = atan(__dir.y, __dir.x) * 1.0 / (PI * 2.0);
		n_out2p0 = vec2(__radius * n_in2p2, __angle * n_in2p3);
	}


// FloatParameter:7
	float n_out7p0 = radius_param;


// FloatParameter:8
	float n_out8p0 = theta_param;


	vec3 n_out5p0;
// Expression:5
	n_out5p0 = vec3(0.0, 0.0, 0.0);
	{
		float r;
		r = sin(n_out2p0.y);
		// n_out5p0 = vec3(distance(n_out2p0.x, n_out7p0));
		n_out5p0 = vec3(distance(n_out2p0.y, n_out8p0));
	}


// Output:0
	ALBEDO = vec3(n_out6p0.xyz);
	EMISSION = n_out5p0;


}
