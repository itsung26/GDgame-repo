code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform bool Blackout;
uniform vec4 layer_1_color : source_color;
uniform vec4 layer_2_color : source_color;
uniform float layer_2_speed;
uniform sampler2D layer_2_mask : filter_nearest;
uniform float layer_1_emission_intensity;
uniform float layer_2_emission_intensity;



void fragment() {
// BooleanParameter:25
	bool n_out25p0 = Blackout;


// ColorParameter:18
	vec4 n_out18p0 = layer_1_color;


// ColorParameter:19
	vec4 n_out19p0 = layer_2_color;


// Input:21
	float n_out21p0 = TIME;


// FloatParameter:23
