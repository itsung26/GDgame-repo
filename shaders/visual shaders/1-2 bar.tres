// FloatOp:24
	float n_out24p0 = n_out21p0 * n_out23p0;


// VectorCompose:22
	float n_in22p0 = 0.00000;
	vec2 n_out22p0 = vec2(n_in22p0, n_out24p0);


// UVFunc:20
	vec2 n_in20p1 = vec2(1.00000, 1.00000);
	vec2 n_out20p0 = n_out22p0 * n_in20p1 + UV;


	vec4 n_out12p0;
// Texture2D:12
	n_out12p0 = texture(layer_2_mask, n_out20p0);


// Mix:7
	vec4 n_out7p0 = mix(n_out18p0, n_out19p0, n_out12p0.x);


// ColorConstant:27
	vec4 n_out27p0 = vec4(0.000000, 0.000000, 0.000000, 1.000000);


	vec3 n_out26p0;
// If:26
	float n_in26p1 = 0.00000;
	float n_in26p2 = 0.00001;
	vec3 n_in26p5 = vec3(0.00000, 0.00000, 0.00000);
	if(abs((n_out25p0 ? 1.0 : 0.0) - n_in26p1) < n_in26p2)
	{
		n_out26p0 = vec3(n_out7p0.xyz);
	}
	else if((n_out25p0 ? 1.0 : 0.0) < n_in26p1)
	{
		n_out26p0 = n_in26p5;
	}
	else
	{
		n_out26p0 = vec3(n_out27p0.xyz);
	}


// ParameterRef:28
	bool n_out28p0 = Blackout;


// FloatParameter:17
	float n_out17p0 = layer_1_emission_intensity;


// VectorOp:16
	vec3 n_out16p0 = vec3(n_out18p0.xyz) * vec3(n_out17p0);


// FloatParameter:14
	float n_out14p0 = layer_2_emission_intensity;


// VectorOp:13
	vec3 n_out13p0 = vec3(n_out19p0.xyz) * vec3(n_out14p0);


// Mix:15
	vec4 n_out15p0 = mix(vec4(n_out16p0, 0.0), vec4(n_out13p0, 0.0), n_out12p0.x);


// ColorConstant:30
	vec4 n_out30p0 = vec4(0.000000, 0.000000, 0.000000, 1.000000);


	vec3 n_out29p0;
// If:29
	float n_in29p1 = 0.00000;
	float n_in29p2 = 0.00001;
	vec3 n_in29p5 = vec3(0.00000, 0.00000, 0.00000);
	if(abs((n_out28p0 ? 1.0 : 0.0) - n_in29p1) < n_in29p2)
	{
		n_out29p0 = vec3(n_out15p0.xyz);
	}
	else if((n_out28p0 ? 1.0 : 0.0) < n_in29p1)
	{
		n_out29p0 = n_in29p5;
	}
	else
	{
		n_out29p0 = vec3(n_out30p0.xyz);
	}


// Output:0
	ALBEDO = n_out26p0;
	EMISSION = n_out29p0;


}
