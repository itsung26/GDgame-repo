code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_disabled, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform vec4 color : source_color;
uniform vec4 color2 : source_color;
uniform sampler2D noise_texture_1 : filter_nearest_mipmap;
uniform float contrast_midlevel = 0.5;
uniform float contrast_level = 0.25;
uniform sampler2D tex_frg_2;



void fragment() {
// ColorParameter:3
	vec4 n_out3p0 = color;


// ColorParameter:8
	vec4 n_out8p0 = color2;


	vec4 n_out6p0;
// Texture2D:6
	n_out6p0 = texture(noise_texture_1, UV);


// FloatParameter:12
	float n_out12p0 = contrast_midlevel;


// FloatParameter:10
	float n_out10p0 = contrast_level;


// FloatOp:9
	float n_out9p0 = n_out6p0.x + n_out10p0;


// FloatOp:11
	float n_out11p0 = n_out6p0.x - n_out10p0;


	vec3 n_out7p0;
// If:7
	float n_in7p2 = 0.00001;
	if(abs(n_out6p0.x - n_out12p0) < n_in7p2)
	{
		n_out7p0 = vec3(n_out9p0);
	}
	else if(n_out6p0.x < n_out12p0)
	{
		n_out7p0 = vec3(n_out11p0);
	}
	else
	{
		n_out7p0 = vec3(n_out9p0);
	}


// Mix:4
	vec2 n_out4p0 = mix(vec2(n_out3p0.xy), vec2(n_out8p0.xy), n_out7p0.x);


// Clamp:13
	vec3 n_in13p1 = vec3(0.00000, 0.00000, 0.00000);
	vec3 n_in13p2 = vec3(1.00000, 1.00000, 1.00000);
	vec3 n_out13p0 = clamp(vec3(n_out4p0, 0.0), n_in13p1, n_in13p2);


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, UV);


// Output:0
	ALBEDO = n_out13p0;
	ALPHA = n_out2p0.x;


}
"
