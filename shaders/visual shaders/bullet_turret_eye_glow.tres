code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_disabled, diffuse_lambert, specular_schlick_ggx;

uniform vec4 color : source_color = vec4(1.000000, 0.000000, 0.000000, 1.000000);
uniform sampler2D gradient;
uniform float emission;



void fragment() {
// ColorParameter:2
	vec4 n_out2p0 = color;


	vec4 n_out4p0;
// Texture2D:4
	n_out4p0 = texture(gradient, UV);


// FloatParameter:6
	float n_out6p0 = emission;


// VectorOp:7
	vec3 n_out7p0 = vec3(n_out2p0.xyz) * vec3(n_out6p0);


// VectorDecompose:8
	float n_out8p0 = vec3(n_out4p0.xyz).x;
	float n_out8p1 = vec3(n_out4p0.xyz).y;
	float n_out8p2 = vec3(n_out4p0.xyz).z;


// VectorCompose:9
	vec3 n_out9p0 = vec3(n_out8p0, n_out8p1, n_out8p2);


// VectorOp:10
	vec3 n_out10p0 = n_out7p0 * n_out9p0;


// Output:0
	ALBEDO = vec3(n_out2p0.xyz);
	ALPHA = n_out4p0.x;
	EMISSION = n_out10p0;


}
"
