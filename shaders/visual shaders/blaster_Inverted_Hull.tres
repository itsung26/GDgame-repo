[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec4 color : source_color = vec4(1.000000, 1.000000, 1.000000, 1.000000);
uniform float oscillate_speed;
uniform float sine_displacement_y;



void fragment() {
// ColorParameter:2
	vec4 n_out2p0 = color;


// Input:6
	float n_out6p0 = TIME;


// FloatFunc:8
	float n_out8p0 = sin(n_out6p0);


// FloatParameter:5
	float n_out5p0 = oscillate_speed;


// FloatOp:7
	float n_out7p0 = n_out8p0 * n_out5p0;


// FloatParameter:10
	float n_out10p0 = sine_displacement_y;


// FloatOp:9
	float n_out9p0 = n_out7p0 + n_out10p0;


// VectorOp:3
	vec3 n_out3p0 = vec3(n_out2p0.xyz) * vec3(n_out9p0);


// Output:0
	ALBEDO = vec3(n_out2p0.xyz);
	EMISSION = n_out3p0;


}
"
