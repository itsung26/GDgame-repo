[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform float oscillate_speed : hint_range(0.0, 100.0) = 5.0;
uniform float frensel = 1.0;
uniform vec4 ColorParameter : source_color = vec4(0.627451, 0.125490, 0.941176, 1.000000);
uniform float alpha : hint_range(0.0, 1.0) = 1.0;
uniform float emissionintensity = 16.0;
uniform float light_diffuse : hint_range(-1.0, 0.0) = 0.0;



void fragment() {
// Input:19
	float n_out19p0 = TIME;


// FloatParameter:22
	float n_out22p0 = oscillate_speed;


// FloatOp:21
	float n_out21p0 = n_out19p0 * n_out22p0;


// FloatFunc:18
	float n_out18p0 = sin(n_out21p0);


// FloatOp:23
	float n_in23p1 = 0.89400;
	float n_out23p0 = n_out18p0 * n_in23p1;


// FloatOp:24
	float n_in24p1 = 4.89400;
	float n_out24p0 = n_out23p0 + n_in24p1;


// FloatParameter:13
	float n_out13p0 = frensel;


// FloatOp:20
	float n_out20p0 = n_out24p0 * n_out13p0;


// Fresnel:11
	float n_out11p0 = pow(1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0), n_out20p0);


// ColorParameter:15
	vec4 n_out15p0 = ColorParameter;


// VectorOp:14
	vec3 n_out14p0 = vec3(n_out11p0) * vec3(n_out15p0.xyz);


// FloatParameter:4
	float n_out4p0 = alpha;


// FloatParameter:17
	float n_out17p0 = emissionintensity;


// VectorOp:16
	vec3 n_out16p0 = n_out14p0 * vec3(n_out17p0);


// Output:0
	ALBEDO = n_out14p0;
	ALPHA = n_out4p0;
	EMISSION = n_out16p0;


}

void light() {
// VectorCompose:2
	float n_in2p0 = 1.00000;
	float n_in2p1 = 1.00000;
	float n_in2p2 = 1.00000;
	vec3 n_out2p0 = vec3(n_in2p0, n_in2p1, n_in2p2);


// FloatParameter:4
	float n_out4p0 = light_diffuse;


// VectorOp:3
	vec3 n_out3p0 = n_out2p0 * vec3(n_out4p0);


// Output:0
	SPECULAR_LIGHT = n_out3p0;


}
"
