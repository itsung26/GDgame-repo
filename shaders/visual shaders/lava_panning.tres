// FloatParameter:8
	float n_out8p0 = scroll_speed;


// FloatOp:10
	float n_out10p0 = n_out6p0 * n_out8p0;


// VectorCompose:9
	float n_in9p0 = 0.00000;
	vec2 n_out9p0 = vec2(n_in9p0, n_out10p0);


// UVFunc:3
	vec2 n_in3p1 = vec2(1.00000, 1.00000);
	vec2 n_out3p0 = n_out9p0 * n_in3p1 + n_out23p0;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out3p0);


// Input:13
	float n_out13p0 = TIME;


// FloatParameter:17
	float n_out17p0 = scroll_speed_emission;


// FloatOp:16
	float n_out16p0 = n_out13p0 * n_out17p0;


// VectorCompose:15
	float n_in15p0 = 0.00000;
	vec2 n_out15p0 = vec2(n_in15p0, n_out16p0);


// UVFunc:14
	vec2 n_in14p1 = vec2(1.00000, 1.00000);
	vec2 n_out14p0 = n_out15p0 * n_in14p1 + n_out23p0;


	vec4 n_out12p0;
// Texture2D:12
	n_out12p0 = texture(Texture2DParameter, n_out14p0);


// ColorParameter:18
	vec4 n_out18p0 = emission_color;


// VectorOp:19
	vec3 n_out19p0 = vec3(n_out12p0.xyz) * vec3(n_out18p0.xyz);


// FloatParameter:20
	float n_out20p0 = emission_intensity;


// VectorOp:21
	vec3 n_out21p0 = n_out19p0 * vec3(n_out20p0);


// Output:0
	ALBEDO = vec3(n_out2p0.xyz);
	EMISSION = n_out21p0;


}
