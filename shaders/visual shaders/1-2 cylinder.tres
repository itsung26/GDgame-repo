[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D Texture2DParameter;
uniform float noise_layer_transpareny : hint_range(0.0, 1.0);
uniform vec4 color : source_color;
uniform float emission_intensity;



void fragment() {
	vec4 n_out6p0;
// Texture2D:6
	n_out6p0 = texture(Texture2DParameter, UV);


// ColorConstant:14
	vec4 n_out14p0 = vec4(0.000000, 0.000000, 0.000000, 0.000000);


// FloatParameter:21
	float n_out21p0 = noise_layer_transpareny;


// FloatOp:20
	float n_out20p0 = n_out6p0.x + n_out21p0;


// Mix:17
	vec4 n_out17p0 = mix(n_out6p0, n_out14p0, vec4(n_out20p0));


// VectorDecompose:18
	float n_out18p0 = n_out17p0.x;
	float n_out18p1 = n_out17p0.y;
	float n_out18p2 = n_out17p0.z;
	float n_out18p3 = n_out17p0.w;


// VectorCompose:19
	vec3 n_out19p0 = vec3(n_out18p0, n_out18p1, n_out18p2);


// ColorParameter:2
	vec4 n_out2p0 = color;


// FloatParameter:3
	float n_out3p0 = emission_intensity;


// VectorOp:4
	vec3 n_out4p0 = vec3(n_out2p0.xyz) * vec3(n_out3p0);


// Output:0
	ALBEDO = n_out19p0;
	EMISSION = n_out4p0;


}
"
