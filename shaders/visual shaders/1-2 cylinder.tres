[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec4 lowest_color : source_color;
uniform vec4 layer_1_color : source_color;
uniform float layer_1_scroll_speed : hint_range(-1.0, 1.0);
uniform sampler2D layer_1_mask_texture : filter_nearest_mipmap;
uniform float top_layer_brightness : hint_range(-1.0, 1.0);
uniform float burn_dark_color_factor : hint_range(0.0, 1.0);
uniform vec4 layer_2_color : source_color = vec4(1.000000, 1.000000, 1.000000, 1.000000);
uniform sampler2D layer_2_mask_texture : filter_nearest_mipmap;
uniform float lowest_color_emission_intensity;
uniform float layer_1_emission_intensity;
uniform float layer_2_emission_intensity;



void fragment() {
// ColorParameter:2
	vec4 n_out2p0 = lowest_color;


// ColorParameter:32
	vec4 n_out32p0 = layer_1_color;


// Input:41
	float n_out41p0 = TIME;


// FloatParameter:43
	float n_out43p0 = layer_1_scroll_speed;


// FloatOp:42
	float n_out42p0 = n_out41p0 * n_out43p0;


// VectorCompose:40
	float n_in40p0 = 0.00000;
	vec2 n_out40p0 = vec2(n_in40p0, n_out42p0);


// UVFunc:39
	vec2 n_in39p1 = vec2(1.00000, 1.00000);
	vec2 n_out39p0 = n_out40p0 * n_in39p1 + UV;


	vec4 n_out6p0;
// Texture2D:6
	n_out6p0 = texture(layer_1_mask_texture, n_out39p0);


// FloatParameter:21
	float n_out21p0 = top_layer_brightness;


// FloatOp:20
	float n_out20p0 = n_out6p0.x + n_out21p0;


// FloatParameter:30
	float n_out30p0 = burn_dark_color_factor;


// ColorOp:28
	vec3 n_out28p0 = vec3(1.0) - (vec3(1.0) - vec3(n_out20p0)) / (vec3(n_out30p0));


// Clamp:24
	float n_in24p1 = 0.00000;
	float n_in24p2 = 1.00000;
	float n_out24p0 = clamp(n_out28p0.x, n_in24p1, n_in24p2);


// Mix:22
	vec4 n_out22p0 = mix(n_out2p0, n_out32p0, vec4(n_out24p0));


// ColorParameter:50
	vec4 n_out50p0 = layer_2_color;


// Reroute:51
	vec4 n_out51p0 = n_out50p0;


	vec4 n_out47p0;
// Texture2D:47
	n_out47p0 = texture(layer_2_mask_texture, UV);


// Reroute:49
	vec4 n_out49p0 = n_out47p0;


// Mix:48
	vec4 n_out48p0 = mix(n_out22p0, n_out51p0, n_out49p0);


// FloatParameter:34
	float n_out34p0 = lowest_color_emission_intensity;


// VectorOp:4
	vec3 n_out4p0 = vec3(n_out2p0.xyz) * vec3(n_out34p0);


// FloatParameter:38
	float n_out38p0 = layer_1_emission_intensity;


// VectorOp:37
	vec3 n_out37p0 = vec3(n_out32p0.xyz) * vec3(n_out38p0);


// Mix:35
	vec4 n_out35p0 = mix(vec4(n_out4p0, 0.0), vec4(n_out37p0, 0.0), vec4(n_out24p0));


// FloatParameter:55
	float n_out55p0 = layer_2_emission_intensity;


// VectorOp:54
	vec3 n_out54p0 = vec3(n_out51p0.xyz) * vec3(n_out55p0);


// Mix:52
	vec4 n_out52p0 = mix(n_out35p0, vec4(n_out54p0, 0.0), n_out49p0);


// Output:0
	ALBEDO = vec3(n_out48p0.xyz);
	EMISSION = vec3(n_out52p0.xyz);


}
"
