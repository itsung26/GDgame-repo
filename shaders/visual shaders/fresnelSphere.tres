// VectorDecompose:4
	float n_out4p0 = n_out2p0.x;
	float n_out4p1 = n_out2p0.y;


// FloatParameter:6
	float n_out6p0 = ring_height;


// FloatParameter:7
	float n_out7p0 = ring_thickness;


	float n_out5p0;
// Expression:5
	n_out5p0 = 0.0;
	{
		float distance_to_top = distance(n_out4p1, n_out6p0);
		float distance_to_bottom = distance(n_out4p1, 1.0 - n_out6p0);
		if (distance_to_top <= n_out7p0 || distance_to_bottom <= n_out7p0) {
			n_out5p0 = 1.0;
		} else {
			n_out5p0 = 0.0;
		}
	}


// Reroute:44
	float n_out44p0 = n_out5p0;


// FloatParameter:12
	float n_out12p0 = vert_stripes_blackoout;


	float n_out8p0;
// Expression:8
	n_out8p0 = 0.0;
	{
		
		if (UV.y > n_out12p0 && UV.y < 1.0 - n_out12p0) {
			n_out8p0 = stripeWave(UV.x, stripe_wave_period, stripe_wave_width, 0.0, 1.0);
		} else {
			n_out8p0 = 0.0;
		}
	}


// Reroute:45
	float n_out45p0 = n_out8p0;


// FloatOp:11
	float n_out11p0 = n_out44p0 + n_out45p0;


// FloatParameter:17
	float n_out17p0 = horizontal_lines_blackout;


	float n_out18p0;
