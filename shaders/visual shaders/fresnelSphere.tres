uniform float inner_fresnel_multiplicant = 1.0;


// GlobalExpression:0
	uniform float stripe_wave_period;
	uniform float stripe_wave_width;
	uniform vec3 grid_color:source_color;
	uniform float grid_color_brightness = 1.0;
