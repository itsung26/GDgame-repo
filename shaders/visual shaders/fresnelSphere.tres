		}
	}


// Reroute:46
	float n_out46p0 = n_out18p0;


// FloatOp:19
	float n_out19p0 = n_out11p0 + n_out46p0;


// Input:22
	vec3 n_out22p0 = NORMAL;


// Input:23
	vec3 n_out23p0 = VIEW;


// FloatParameter:25
	float n_out25p0 = outer_fresnel_power;


	float n_out24p0;
// Expression:24
	n_out24p0 = 0.0;
	{
		n_out24p0 = 1.0 - dotAngleDifference(n_out23p0, n_out22p0);
		n_out24p0 = pow(n_out24p0, n_out25p0);
	}


// Reroute:43
	float n_out43p0 = n_out24p0;


// FloatOp:26
	float n_out26p0 = n_out19p0 + n_out43p0;


// Clamp:34
	float n_in34p1 = 0.00000;
	float n_in34p2 = 1.00000;
	float n_out34p0 = clamp(n_out26p0, n_in34p1, n_in34p2);


// Input:30
	vec3 n_out30p0 = NORMAL;


// Input:31
	vec3 n_out31p0 = VIEW;


// FloatParameter:32
	float n_out32p0 = inner_fresnel_power;


// FloatParameter:35
	float n_out35p0 = inner_fresnel_multiplicant;


	float n_out29p0;
// Expression:29
	n_out29p0 = 0.0;
	{
		n_out29p0 = dotAngleDifference(n_out31p0, n_out30p0);
		n_out29p0 = n_out29p0 * n_out35p0;
		n_out29p0 = pow(n_out29p0, n_out32p0);
	}


// Reroute:42
	float n_out42p0 = n_out29p0;


// FloatOp:33
	float n_out33p0 = n_out34p0 - n_out42p0;


// Clamp:27
	float n_in27p1 = 0.00000;
	float n_in27p2 = 1.00000;
	float n_out27p0 = clamp(n_out33p0, n_in27p1, n_in27p2);


	vec3 n_out36p0;
// Expression:36
	n_out36p0 = vec3(0.0, 0.0, 0.0);
	{
		vec2 uv_scaled = UV * screen_uv_scale;
		vec2 uv_scaled_and_panned = uv_scaled + screen_uv_offset;
		vec3 col = texture(noise_texture, uv_scaled + vec2(TIME, TIME)).xyz;
		n_out36p0 = col;
	}


// Reroute:41
	vec3 n_out41p0 = n_out36p0;


// FloatOp:40
	float n_out40p0 = n_out27p0 * n_out41p0.x;


// Clamp:50
	float n_in50p1 = 0.00000;
	float n_in50p2 = 1.00000;
	float n_out50p0 = clamp(n_out40p0, n_in50p1, n_in50p2);


// Mix:38
	vec3 n_out38p0 = mix(n_out49p0, n_out39p0, n_out50p0);


