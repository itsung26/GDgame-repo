	vec3 n_out48p0;
// Expression:48
	n_out48p0 = vec3(0.0, 0.0, 0.0);
	{
		n_out48p0 = texture(inner_texture, UV).xyz;
		n_out48p0 = mix(n_out48p0, vec3(n_out54p0.xyz), vec3(n_out55p0));
		n_out48p0 = n_out48p0 * inner_texture_brightness;
	}


// Reroute:49
	vec3 n_out49p0 = n_out48p0;


	vec3 n_out39p0;
// Expression:39
	n_out39p0 = vec3(0.0, 0.0, 0.0);
