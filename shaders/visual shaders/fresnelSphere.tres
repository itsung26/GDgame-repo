[sub_resource type="VisualShaderNodeGlobalExpression" id="VisualShaderNodeGlobalExpression_mca8t"]
size = Vector2(960, 1080)
expression = "uniform float stripe_wave_period;
uniform float stripe_wave_width;
uniform vec3 grid_color:source_color;
uniform float grid_color_brightness = 1.0;
uniform sampler2D noise_texture;
uniform vec2 screen_uv_offset = vec2(0.0);
uniform vec2 screen_uv_scale = vec2(1.0);
uniform sampler2D inner_texture:filter_nearest;
uniform float inner_texture_brightness = 1.0;

float squareWave(float x, float y_stretch, float y_displacement, float p) {
	return y_stretch * (4.0 * floor(p * x) - 2.0 * floor(2.0 * p * x) + 1.0) + y_displacement;
}


float stripeWave(float x, float period_2, float width, float y_low, float y_high) {
	float phase = fract(x * period_2);
	float s = step(phase, width);
	return mix(y_low, y_high, s);
}


// returns the dot product between a view vector and a normal vector
float dotAngleDifference(vec3 p_view_vector, vec3 p_normal) {
	vec3 view_vector = normalize(p_view_vector);
	vec3 normal = normalize(p_normal);
	return dot(view_vector, normal);
}"

