[sub_resource type="GDScript" id="GDScript_qkknv"]
script/source = "extends Node

@onready var ammo_panel: SubViewportContainer = $\"../BottomLeftArea/AmmoPanel\"
@export var enabled:bool = true

func _ready() -> void:
	if enabled:
		ammo_panel.setRot()
"

