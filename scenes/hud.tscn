[sub_resource type="GDScript" id="GDScript_48y67"]
resource_name = "Editor functions"
script/source = "@tool
extends SubViewportContainer

@export_tool_button(\"set rotate\") var a = setRot
@export_tool_button(\"unset rotate\") var b = unsetRot



func setRot():
	var shader:ShaderMaterial = material
	shader.set_shader_parameter(\"rot_y_deg\", 18.0)
	
func unsetRot():
	var shader:ShaderMaterial = material
	shader.set_shader_parameter(\"rot_y_deg\", 0)
"

