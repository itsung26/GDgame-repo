[sub_resource type="GDScript" id="GDScript_o4vap"]
script/source = "@tool
extends RayCast3D

@onready var targ_l_global: Marker3D = $TargLGlobal

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	targ_l_global.position = target_position
	targ_l_global.global_rotation = Vector3.ZERO

func getDir() -> Vector3:
	var ret:Vector3 = (targ_l_global.global_position - global_position).normalized()
	return ret
"

[sub_resource type="GDScript" id="GDScript_lqrsi"]
script/source = "@tool
extends RayCast3D

@onready var targ_r_global: Marker3D = $TargRGlobal

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	targ_r_global.position = target_position
	targ_r_global.global_rotation = Vector3.ZERO

func getDir() -> Vector3:
	var ret:Vector3 = (targ_r_global.global_position - global_position).normalized()
	return ret
"

