[sub_resource type="GDScript" id="GDScript_j6hpd"]
resource_name = "enemy spawn test"
script/source = "extends Area3D
@onready var enemy_spawn_handler: EnemySpawnHandler = $\"../EnemySpawnHandler\"


func _on_body_entered(plr: Player) -> void:
	print(\"plr enterd spawning enemies\")
	enemy_spawn_handler.spawnEnemies()
"

