[sub_resource type="GDScript" id="GDScript_0a70l"]
resource_name = "FogToggler"
script/source = "@tool
extends WorldEnvironment

@export_tool_button(\"Enable Fog\") var action1 = enable_fog
@export_tool_button(\"Disable Fog\") var action2 = disable_fog

func disable_fog():
	environment.fog_enabled = false
	environment.volumetric_fog_enabled = false
	
func enable_fog():
	environment.fog_enabled = true
	environment.volumetric_fog_enabled = true
"

