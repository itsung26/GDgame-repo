code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec2 offset;
uniform vec2 scale = vec2(1.000000, 1.000000);
uniform sampler2D Texture2DParameter;
uniform float FloatParameter;
uniform vec4 ColorParameter : source_color;
uniform float emission_intensity;



void fragment() {
// Vector2Parameter:10
	vec2 n_out10p0 = offset;


// UVFunc:9
	vec2 n_in9p1 = vec2(1.00000, 1.00000);
	vec2 n_out9p0 = n_out10p0 * n_in9p1 + UV;


// Vector2Parameter:7
	vec2 n_out7p0 = scale;


// UVFunc:6
	vec2 n_in6p2 = vec2(0.00000, 0.00000);
	vec2 n_out6p0 = (n_out9p0 - n_in6p2) * n_out7p0 + n_in6p2;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Texture2DParameter, n_out6p0);


// FloatParameter:5
	float n_out5p0 = FloatParameter;


// FloatOp:8
	float n_out8p0 = pow(n_out3p0.x, n_out5p0);


// Distance:11
	vec3 n_in11p1 = vec3(0.00000, 0.00000, 0.00000);
	float n_out11p0 = distance(vec3(n_out8p0), n_in11p1);


// FloatFunc:12
	float n_out12p0 = 1.0 - n_out11p0;


// FloatOp:13
	float n_out13p0 = n_out8p0 - n_out12p0;


// Clamp:17
	float n_in17p1 = 0.00000;
	float n_in17p2 = 1.00000;
	float n_out17p0 = clamp(n_out13p0, n_in17p1, n_in17p2);


// ColorParameter:14
	vec4 n_out14p0 = ColorParameter;


// FloatParameter:16
	float n_out16p0 = emission_intensity;


// VectorOp:15
	vec3 n_out15p0 = vec3(n_out14p0.xyz) * vec3(n_out16p0);


// Output:0
	ALPHA = n_out17p0;
	EMISSION = n_out15p0;


}
"
