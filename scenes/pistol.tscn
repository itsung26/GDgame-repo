[sub_resource type="VisualShader" id="VisualShader_lfdsj"]
resource_local_to_scene = true
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform sampler2D screen_texture;
uniform float emission : hint_range(0.0, 16.0);



void fragment() {
	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(screen_texture, UV);


// FloatParameter:5
	float n_out5p0 = emission;


// VectorOp:4
	vec3 n_out4p0 = vec3(n_out3p0.xyz) * vec3(n_out5p0);


// Output:0
	ALBEDO = vec3(n_out3p0.xyz);
	EMISSION = n_out4p0;


}
"
flags/unshaded = true
preview_params/screen_texture = "Object(ViewportTexture,\"resource_local_to_scene\":true,\"resource_name\":\"\",\"viewport_path\":NodePath(\"SubViewport\"),\"script\":null)
"
