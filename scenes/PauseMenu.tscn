[sub_resource type="GDScript" id="GDScript_5w6ei"]
resource_name = "change colors"
script/source = "extends HBoxContainer
@onready var difficulty_dropdown: OptionButton = $DifficultyDropdown

enum difficulties {EASY, MEDIUM, HARD, BRUTAL}


func _ready() -> void:
	difficulty_dropdown.selected = difficulties.EASY
	changeColor(getDifficultyColor(difficulties.EASY))


func _on_difficulty_dropdown_item_selected(new_difficulty: int) -> void:
	changeColor(getDifficultyColor(new_difficulty))


func changeColor(new_color:Color) -> void:
	difficulty_dropdown.add_theme_color_override(\"font_color\", new_color)
	difficulty_dropdown.add_theme_color_override(\"font_focus_color\", new_color)
	difficulty_dropdown.add_theme_color_override(\"font_hover_color\", new_color)
	difficulty_dropdown.add_theme_color_override(\"font_hover_pressed_color\", new_color)
	difficulty_dropdown.add_theme_color_override(\"font_pressed_color\", new_color)


## Checks which item is selected and returns the corresponding font color.
func getDifficultyColor(difficulty:int) -> Color:
	match difficulty:
		difficulties.EASY:
			return Color.GREEN
		difficulties.MEDIUM:
			return Color.YELLOW
		difficulties.HARD:
			return Color.RED
		difficulties.BRUTAL:
			return Color.PURPLE
		_:
			return Color.WHITE
"

