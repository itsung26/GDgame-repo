// FloatParameter:5
	float n_out5p0 = emission;


// VectorOp:6
	vec3 n_out6p0 = n_out4p0 * vec3(n_out5p0);


// Output:0
	ALBEDO = n_out4p0;
	ALPHA = n_out2p0.x;
	EMISSION = n_out6p0;


}
