resource_local_to_scene = true
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec4 ColorParameter : source_color;
uniform vec2 scale = vec2(1.000000, 1.000000);
uniform sampler2D Texture2DParameter;
uniform float emission : hint_range(0.0, 16.0) = 0.0;



void fragment() {
// ColorParameter:7
	vec4 n_out7p0 = ColorParameter;


// Vector2Parameter:12
	vec2 n_out12p0 = scale;


// UVFunc:11
	vec2 n_in11p2 = vec2(0.00000, 0.00000);
	vec2 n_out11p0 = (UV - n_in11p2) * n_out12p0 + n_in11p2;


// Input:6
	float n_out6p0 = TIME;


// VectorCompose:5
	float n_in5p1 = 0.00000;
	vec2 n_out5p0 = vec2(n_out6p0, n_in5p1);


// UVFunc:4
	vec2 n_in4p1 = vec2(1.00000, 1.00000);
	vec2 n_out4p0 = n_out5p0 * n_in4p1 + n_out11p0;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Texture2DParameter, n_out4p0);


// VectorOp:8
	vec3 n_out8p0 = vec3(n_out7p0.xyz) * vec3(n_out3p0.xyz);


// FloatParameter:10
	float n_out10p0 = emission;


// VectorOp:9
	vec3 n_out9p0 = n_out8p0 * vec3(n_out10p0);


// Output:0
	ALBEDO = n_out8p0;
	EMISSION = n_out9p0;


}
