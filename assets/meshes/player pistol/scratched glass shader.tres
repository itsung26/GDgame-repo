code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec4 ColorParameter : source_color = vec4(1.000000, 1.000000, 1.000000, 1.000000);
uniform float alpha : hint_range(0.0, 1.0);
uniform vec2 offset;
uniform float scale = 1.0;
uniform sampler2D Texture2DParameter : filter_nearest_mipmap;



void fragment() {
// ColorParameter:4
	vec4 n_out4p0 = ColorParameter;


// FloatParameter:10
	float n_out10p0 = alpha;


// Vector2Parameter:5
	vec2 n_out5p0 = offset;


// UVFunc:6
	vec2 n_in6p1 = vec2(1.00000, 1.00000);
	vec2 n_out6p0 = n_out5p0 * n_in6p1 + UV;


// FloatParameter:9
	float n_out9p0 = scale;


// UVFunc:7
	vec2 n_in7p2 = vec2(0.50000, 0.50000);
	vec2 n_out7p0 = (n_out6p0 - n_in7p2) * vec2(n_out9p0) + n_in7p2;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Texture2DParameter, n_out7p0);


// VectorOp:11
	vec3 n_out11p0 = vec3(n_out10p0) * vec3(n_out3p0.xyz);


// Output:0
	ALBEDO = vec3(n_out4p0.xyz);
	ALPHA = n_out11p0.x;


}
