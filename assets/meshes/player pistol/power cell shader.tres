code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec4 ColorParameter : source_color = vec4(1.000000, 1.000000, 1.000000, 1.000000);
uniform vec2 scale = vec2(1.000000, 1.000000);
uniform float time_speed;
uniform sampler2D Texture2DParameter;
uniform float emission_intensity : hint_range(0.0, 16.0);



void fragment() {
// ColorParameter:4
	vec4 n_out4p0 = ColorParameter;


// Vector2Parameter:9
	vec2 n_out9p0 = scale;


// Input:10
	float n_out10p0 = TIME;


// FloatParameter:11
	float n_out11p0 = time_speed;


// FloatOp:12
	float n_out12p0 = n_out10p0 * n_out11p0;


// VectorCompose:13
	float n_in13p1 = 0.00000;
	vec2 n_out13p0 = vec2(n_out12p0, n_in13p1);


// UVFunc:8
	vec2 n_out8p0 = n_out13p0 * n_out9p0 + UV;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Texture2DParameter, n_out8p0);


// VectorOp:5
	vec3 n_out5p0 = vec3(n_out4p0.xyz) * vec3(n_out3p0.xyz);


// FloatParameter:6
	float n_out6p0 = emission_intensity;


// VectorOp:7
	vec3 n_out7p0 = n_out5p0 * vec3(n_out6p0);


// Output:0
	ALBEDO = n_out5p0;
	EMISSION = n_out7p0;


}
